{
  "name": "playwright_integration_testing",
  "version": "1.0.0",
  "description": "This project involves utilizing Playwright for end-to-end testing, covering both API and UI components in a comprehensive manner.",
  "main": "index.js",
  "preset": "jest-playwright-preset",
  "testTimeout": 30000,
  "scripts": {
    "test-qc": "cucumber-js test",
    "test-smoke-staging": "cucumber-js test --tags @smoke",
    "test-smoke-prod": "set PRODUCTION=true && cucumber-js test --tags @smoke",
    "test-regression-staging": "cucumber-js test --tags @regression",
    "test-prod": "set PRODUCTION=true && cucumber-js test",
    "posttest": "npx ts-node src/test/hooks/report.ts",
    "test-uat": "set UAT=true && cucumber-js test --tags @uat",
    "test-uat-ui": "set UAT=true && cucumber-js  --tags @uat",
    "test-uat-api": "set UAT=true && cucumber-js --tags @uat",
    "test:api": "jest api-tests/*.ts",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "lint:fix-ts": "eslint . --ext .ts --fix --rule '@typescript-eslint/no-inferrable-types: warn' --rule '@typescript-eslint/prefer-as-const: warn'",
    "lint:fix-unused": "npm run lint:fix && node -e \"console.log('Auto-fixed formatting issues. For unused variables, prefix with underscore (_) or remove if not needed.')\"",
    "lint:check": "eslint . --ext .ts,.js --max-warnings 0",
    "prepare": "husky install",
    "pre-push": "npm run lint:fix && npm run lint:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.1",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@wdio/allure-reporter": "^8.24.2",
    "axios": "^1.6.2",
    "chai": "^4.3.10",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "husky": "^8.0.3",
    "jest-playwright-preset": "^4.0.0",
    "mocha": "^10.2.0",
    "playwright": "^1.40.1",
    "playwright-bdd": "^8.4.2",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "module": "^1.2.5",
    "multiple-cucumber-html-reporter": "^3.8.0",
    "node": "^23.5.0",
    "ts": "^0.0.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  }
}
