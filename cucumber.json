{
    "default": {
        "formatOptions": {
            "snippetInterface": "async-await"
        },
        "paths": [
            "src/test/features/**/*.feature"
        ],
        "publishQuiet": true,
        "require": [
            "src/test/steps/**/*.steps.ts",
            "src/test/hooks/hooks.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "format": [
            "progress-bar",
            "json:test-results/cucumber-report.json"
        ]
    }
}